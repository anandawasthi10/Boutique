# Environment Configuration for Handmade Fabric Accessories Store Backend
NODE_ENV=development
PORT=3001
APP_BASE_URL=http://localhost:3001
FRONTEND_ORIGIN=http://localhost:3000

# Database (Neon Postgres)
# Pooled connection string used at runtime (host contains -pooler)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/boutique?sslmode=require
# Direct connection string used for migrations
DATABASE_URL_DIRECT=postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/boutique?sslmode=require

# Authentication & Sessions
# Must be at least 32 characters
SESSION_SECRET=change-me-to-a-secure-random-string-with-at-least-32-characters
SEED_DEV_USER_PASSWORD=change-me-dev-password
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Staff API Key for protected catalogue and order management routes (min 16 chars)
STAFF_API_KEY=staff-secret-key-min-16-chars-long

# Payments (fake | razorpay)
PAYMENT_GATEWAY=fake
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Email (Fake in dev/test, provider in production)
EMAIL_API_KEY=
EMAIL_FROM=orders@boutique.local

# Logging
LOG_LEVEL=info

# Commerce Rules
SHIPPING_FLAT_RATE=0
TAX_RATE_BPS=0
