# Public frontend configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_USE_MOCK_API=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ALLOW_INDEXING=false

# Neon Auth Configuration (Neon Console -> Project: Boutique -> Auth)
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-weathered-smoke-b5h1lrnh.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=https://ep-weathered-smoke-b5h1lrnh.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-weathered-smoke-b5h1lrnh.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_AUTH_COOKIE_SECRET=change-me-to-a-secure-random-string-with-at-least-32-characters

# Backend Configuration (see backend/.env.example for details)
NODE_ENV=development
PORT=3001
APP_BASE_URL=http://localhost:3001
# Neon Postgres Database Connection Strings (Project: Boutique - AWS US East 2)
# Pooled connection string used at runtime (host contains -pooler)
DATABASE_URL=postgresql://neondb_owner:<YOUR_NEON_PASSWORD>@ep-weathered-smoke-b5h1lrnh-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require
# Direct connection string used for migrations
DATABASE_URL_DIRECT=postgresql://neondb_owner:<YOUR_NEON_PASSWORD>@ep-weathered-smoke-b5h1lrnh.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require
SESSION_SECRET=change-me-to-a-secure-random-string-with-at-least-32-characters
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
STAFF_API_KEY=staff-secret-key-min-16-chars-long
PAYMENT_GATEWAY=fake
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
EMAIL_API_KEY=
EMAIL_FROM=orders@boutique.local
LOG_LEVEL=info
SHIPPING_FLAT_RATE=0
TAX_RATE_BPS=0
