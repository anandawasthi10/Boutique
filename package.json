{
  "name": "handmade-accessories-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
    "backend:test": "npm --prefix backend test",
    "backend:lint": "npm --prefix backend run lint",
    "backend:typecheck": "npm --prefix backend run typecheck",
    "backend:migrate": "npm --prefix backend run db:migrate",
    "backend:seed": "npm --prefix backend run db:seed"
  },
  "dependencies": {
    "framer-motion": "^14.1.0",
    "lucide-react": "^1.55.0",
    "next": "^16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.15"
  }
}
